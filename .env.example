# ──────────────────────────────────────────────
# Sentinel — variáveis de ambiente (exemplo)
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA comite o arquivo .env no repositório.
# ──────────────────────────────────────────────

# Ambiente de execução: development | staging | production
SENTINEL_ENV=development

# Nível de log: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
# Chave secreta para autenticação via header X-Api-Key (mude em produção)
API_SECRET_KEY=change-me-in-production
# Origens permitidas no CORS (separadas por vírgula; * libera todas)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Tamanho máximo de batch por requisição
MAX_BATCH_SIZE=10000

# Caminhos de dados (relativos à raiz do projeto)
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_SYNTHETIC_DIR=data/synthetic

# Modelos
MODEL_DIR=models
MODEL_VERSION=v1

# Limiares de detecção (valores padrão; ajuste após calibração)
ALERT_SCORE_THRESHOLD=0.6
RULE_MIN_ATTEMPTS=5

# MCP (integração opcional)
MCP_ENABLED=false
MCP_HOST=0.0.0.0
MCP_PORT=9000

# Monitoramento / drift
DRIFT_REFERENCE_PATH=data/processed/reference_distribution.json
DRIFT_ALERT_THRESHOLD=0.1
